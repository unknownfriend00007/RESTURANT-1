# =====================================================
# RESTAURANT ORDERING SYSTEM - ENVIRONMENT VARIABLES
# =====================================================
# SECURITY NOTE:
# - VITE_ prefix = PUBLIC (exposed to browser)
# - No prefix = SECRET (backend only)
# - NEVER expose SECRET keys to frontend
# =====================================================

# =====================================================
# RAZORPAY CONFIGURATION
# =====================================================
# Get from: https://dashboard.razorpay.com/app/keys

# PUBLIC KEY (both frontend and backend)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# SECRET KEY (backend ONLY - NEVER expose to frontend)
RAZORPAY_KEY_SECRET=YOUR_SECRET_KEY

# WEBHOOK SECRET (backend ONLY)
# Get from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Get from: https://app.supabase.com/project/_/settings/api

# PUBLIC URL (both frontend and backend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# ANON KEY (frontend with RLS)
SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# SERVICE ROLE KEY (backend ONLY - full database access)
# WARNING: This key bypasses Row Level Security!
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
VITE_APP_NAME=Your Restaurant Name
VITE_APP_URL=https://yoursite.vercel.app

# =====================================================
# SECURITY CHECKLIST
# =====================================================
# ✅ RAZORPAY_KEY_SECRET is NEVER in VITE_ variables
# ✅ RAZORPAY_WEBHOOK_SECRET is NEVER in VITE_ variables
# ✅ SUPABASE_SERVICE_KEY is NEVER in VITE_ variables
# ✅ All VITE_ variables are PUBLIC and safe to expose
# ✅ Environment variables set in Vercel dashboard
# ✅ .env file is in .gitignore (never committed)
# =====================================================
